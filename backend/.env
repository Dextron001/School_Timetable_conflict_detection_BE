# ── ResolvIt Backend Configuration ──────────────────────────────
# Copy this file as .env and fill in real values for production.
# In development the defaults below work out-of-the-box.

# JWT signing key — CHANGE THIS for production! Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me-in-production

# Database URL. SQLite for local dev; switch to Postgres for hosting:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./timetable.db

# Comma-separated list of allowed frontend origins (for CORS).
# Add your deployed URL here when you host, e.g.:
#   http://localhost:5173,https://resolvit.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Email notifications (disabled by default) ──────────────────
# To enable complaint email notifications, set SMTP_ENABLED=true
# and fill in the SMTP credentials. Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASSWORD=your_app_password
#   ADMIN_EMAIL=admin@yourdomain.com
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=